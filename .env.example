# ==============================================================================
# iStore ERP - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure the variables according to your environment.

# ── Application & Security ───────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-this-to-a-secure-32-plus-character-secret-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://i-store-website.vercel.app

# ── Database Connection ───────────────────────────────────────────────────────
# SQLite (Local Desktop / Development)
DATABASE_URL=sqlite:///./database/istore.db

# PostgreSQL (Production / Neon.tech / Cloud)
# DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/istoredb?sslmode=require

# ── AI Integration (Google Gemini) ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── WhatsApp Microservice Integration ─────────────────────────────────────────
WHATSAPP_SERVICE_SECRET=your_secure_whatsapp_service_secret_token
WHATSAPP_SERVICE_URL=http://127.0.0.1:3001
WHATSAPP_SERVICE_PORT=3001

# ── Cloud Backups (Firebase / Cloudflare R2) ──────────────────────────────────
# Firebase Storage
FIREBASE_SERVICE_ACCOUNT=assets/serviceAccountKey.json
FIREBASE_BUCKET=your-project-id.appspot.com

# Cloudflare R2 (Optional Zero-Egress Storage)
# R2_ACCESS_KEY=your_r2_access_key
# R2_SECRET_KEY=your_r2_secret_key
# R2_BUCKET=istore-media
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=https://cdn.yourdomain.com

# ── Public Customer Portal ───────────────────────────────────────────────────
CUSTOMER_PORTAL_URL=https://i-store-customer-portal.vercel.app

# ── Frontend Build Variables (Vite) ──────────────────────────────────────────
# VITE_API_URL=http://127.0.0.1:8000
