# =============================================================================
# I-STORE HYBRID ERP ENGINE - PRODUCTION CONFIGURATION
# =============================================================================

# Server Environment & Core Flags
ENV=production
DEBUG=false
APP_NAME=I-Store ERP
APP_VERSION=2.4.0
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL for Server Node or SQLite for local POS Node)
DATABASE_URL=sqlite:///./database/estore_master.db
# DATABASE_URL=postgresql://istore_user:SECURE_PASSWORD@localhost:5432/istore_erp
DB_SCHEMA_VERSION=2026_08_v1
AUTO_MIGRATE_ENABLED=true
BACKUP_BEFORE_MIGRATE=true
ALLOW_RUNTIME_SCHEMA_SYNC=false

# Central Ed25519 Licensing Verification
ESTORE_PUBLIC_KEY_B64=PASTE_MATCHING_PUBLIC_KEY_FROM_CONTROL_CENTER_HERE
LICENSE_CACHE_FILE=database/license_cache.json
ALLOW_DEV_LICENSE_BYPASS=false
CONTROL_CENTER_URL=https://control.your-domain.com

# Customer Portal & Auth Security Secrets
PORTAL_AUTH_SECRET=GENERATE_64_CHAR_HEX_SECRET_KEY_FOR_PORTAL_SESSIONS_HERE
SECRET_KEY=GENERATE_64_CHAR_HEX_SECRET_KEY_FOR_ERP_STAFF_JWT_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# WhatsApp Cloud API (Automated Customer Notifications & OTP)
WHATSAPP_ENABLED=true
WHATSAPP_ACCESS_TOKEN=PASTE_META_WHATSAPP_PERMANENT_ACCESS_TOKEN_HERE
WHATSAPP_PHONE_NUMBER_ID=PASTE_META_PHONE_NUMBER_ID_HERE
WHATSAPP_BUSINESS_ACCOUNT_ID=PASTE_META_WABA_ID_HERE

# Supabase Cloud Sync & Transactional Outbox
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PASTE_SUPABASE_SERVICE_ROLE_KEY_HERE
SUPABASE_ANON_KEY=PASTE_SUPABASE_ANON_KEY_HERE
SYNC_OUTBOX_BATCH_SIZE=25
SYNC_OUTBOX_INTERVAL_SECONDS=30

# Backup & Disaster Recovery
BACKUP_DIR=./backups
BACKUP_MAX_KEEP_DAYS=30
BACKUP_ENCRYPT=true
BACKUP_ENCRYPTION_KEY=PASTE_FERNET_ENCRYPTION_KEY_HERE

# Production CORS & Security
CORS_ORIGINS=["https://pos.your-domain.com", "https://portal.your-domain.com"]
